---
import { Image } from 'astro:assets';
import reformers from '../assets/img/photo-reformers.jpg';
import pose from '../assets/img/pose-wine.png';
import sun from '../assets/img/sun-wine.png';

const classes = [
	{
		name: 'Fundamentos del Reformer',
		meta: ['50 min', 'Principiante'],
		copy: 'Aprende a usar el Reformer, a respirar durante el ejercicio y los principios básicos, en una clase más pausada y con muchas explicaciones. Si nunca has hecho pilates, empieza aquí.',
	},
	{
		name: 'Reformer Flow',
		meta: ['50 min', 'Todos los niveles'],
		copy: 'Nuestra clase estrella: una secuencia fluida de cuerpo completo para ganar fuerza, flexibilidad y control.',
	},
	{
		name: 'Esculpe y quema',
		meta: ['45 min', 'Nivel intermedio'],
		copy: 'Más ritmo y más carga en los resortes, sin perder la precisión. Es una clase exigente y sales con energía.',
	},
	{
		name: 'Conceptos básicos sobre la colchoneta',
		meta: ['45 min', 'Todos los niveles'],
		copy: 'Ejercicios clásicos en colchoneta con accesorios pequeños. Aquí trabajas la fuerza del tronco y la movilidad que luego usarás en el resto de clases.',
	},
	{
		name: 'Pre y posparto',
		meta: ['50 min', 'Especialista'],
		copy: 'Una clase suave, adaptada a cada etapa del embarazo y el posparto, con monitores formados para acompañarte.',
	},
	{
		name: 'Sesiones privadas',
		meta: ['55 min', '1:1 o dúo'],
		copy: 'Un programa hecho para ti, ya sea para rehabilitarte, para un objetivo concreto o porque prefieres tener al monitor solo para ti. Trabajamos con Reformer, silla y torre.',
	},
];
---

<section id="classes" data-nav-theme="wine" data-classes class="relative overflow-hidden bg-wine text-cream">
	<div data-classes-pin class="flex min-h-svh flex-col justify-center py-24 lg:py-0">
		<div class="mx-auto mb-12 flex w-full max-w-[1600px] flex-col justify-between gap-6 px-5 sm:px-10 lg:mb-14 lg:flex-row lg:items-end">
			<div>
				<p data-reveal class="eyebrow mb-6 flex items-center gap-4 text-cream/80"><span class="h-px w-10 bg-current"></span> Clases</p>
				<h2 data-split class="display text-[clamp(3rem,7vw,6.5rem)] font-light">
					Encuentra tu <em class="italic">ritmo.</em>
				</h2>
			</div>
			<div class="flex items-center gap-6">
				<p data-reveal class="max-w-xs text-[0.95rem] leading-relaxed text-cream/75">
					Seis tipos de clase y la misma atención en todas: nunca más de ocho alumnos.
				</p>
				<div class="hidden h-px w-40 overflow-hidden bg-cream/20 lg:block">
					<div data-classes-progress class="h-full w-full origin-left scale-x-0 bg-cream"></div>
				</div>
			</div>
		</div>

		<div data-classes-track class="flex flex-col gap-5 px-5 sm:px-10 lg:w-max lg:flex-row lg:gap-6">
			<article data-reveal class="relative hidden h-[min(34rem,62vh)] w-[38rem] shrink-0 overflow-hidden rounded-[2rem] lg:block">
				<Image src={reformers} alt="Un reformer de madera de la marca Veta en un estudio bañado por la luz del sol" widths={[800, 1200]} sizes="38rem" class="h-full w-full object-cover" />
				<div class="absolute inset-0 bg-gradient-to-t from-wine/70 via-transparent to-transparent"></div>
				<p class="display absolute bottom-8 left-8 max-w-xs text-4xl italic">Reformers de madera, en cada clase.</p>
			</article>
			{
				classes.map((c, i) => (
					<article
						data-reveal
						data-class-card
						class="group relative flex min-h-[26rem] shrink-0 flex-col justify-between overflow-hidden rounded-[2rem] bg-cream p-8 text-wine sm:p-10 lg:h-[min(34rem,62vh)] lg:min-h-[28rem] lg:w-[25rem]"
					>
						<div class="flex items-start justify-between">
							<span class="eyebrow">{String(i + 1).padStart(2, '0')} / {String(classes.length).padStart(2, '0')}</span>
							<Image src={sun} alt="" width={100} class="w-8 transition-transform duration-[1.2s] ease-(--ease-soft) group-hover:rotate-[200deg]" />
						</div>
						<Image
							src={pose}
							alt=""
							width={500}
							class="pointer-events-none absolute -right-16 top-1/2 w-64 -translate-y-1/2 opacity-[0.06] transition-all duration-1000 ease-(--ease-soft) group-hover:-right-8 group-hover:opacity-[0.12]"
						/>
						<div class="relative">
							<div class="mb-6 flex gap-2">
								{c.meta.map((m) => (
									<span class="rounded-full border border-wine/25 px-3 py-1.5 text-[0.65rem] font-semibold tracking-[0.18em] uppercase">{m}</span>
								))}
							</div>
							<h3 class="display mb-4 text-[2.6rem] leading-none">{c.name}</h3>
							<p class="mb-8 text-[0.92rem] leading-relaxed text-wine/75">{c.copy}</p>
							<a href="#pricing" class="eyebrow link-underline inline-flex items-center gap-3">
								Reserva esta clase <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))
			}
			<div class="hidden w-[10vw] shrink-0 lg:block" aria-hidden="true"></div>
		</div>
	</div>
</section>
