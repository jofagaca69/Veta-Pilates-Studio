---
import { Image } from 'astro:assets';
import sunCream from '../assets/img/sun-cream.png';

const plans = [
	{
		name: 'Oferta de bienvenida',
		price: '59',
		unit: '3 clases',
		note: 'Solo para nuevos clientes · válido durante 30 días',
		features: ['Cualquier clase en grupo', 'Visita al estudio y montaje', 'Calcetines antideslizantes gratis', 'Reserva con 14 días de antelación'],
		cta: 'Empieza por aquí',
		featured: false,
	},
	{
		name: 'Ilimitado',
		price: '289',
		unit: 'al mes',
		note: 'Renovación automática · Se puede pausar en cualquier momento',
		features: ['Clases en grupo ilimitadas', 'Reserva prioritaria, 21 días', '2 pases para invitados al mes', '10 % de descuento en clases particulares y productos al por menor'],
		cta: 'Hazte socio',
		featured: true,
	},
	{
		name: 'Bono de 8 clases',
		price: '240',
		unit: '8 clases',
		note: 'Válido durante 3 meses',
		features: ['Cualquier clase en grupo', 'Compártelo con un amigo', 'Reserva con 14 días de antelación', 'Toallas y taquillas incluidas'],
		cta: 'Comprar paquete',
		featured: false,
	},
];
---

<section id="pricing" data-nav-theme="cream" class="relative bg-cream-light py-28 sm:py-40">
	<div class="mx-auto max-w-[1600px] px-5 sm:px-10">
		<div class="mb-16 text-center lg:mb-24">
			<p data-reveal class="eyebrow mb-6 inline-flex items-center gap-4"><span class="h-px w-10 bg-current"></span> Precios <span class="h-px w-10 bg-current"></span></p>
			<h2 data-split class="display mx-auto max-w-4xl text-[clamp(3rem,7vw,6.5rem)] font-light">
				Empieza <em class="italic">suavemente.</em>
			</h2>
		</div>

		<div class="grid items-stretch gap-5 lg:grid-cols-3 lg:gap-6">
			{
				plans.map((p) => (
					<article
						data-reveal
						class:list={[
							'relative flex flex-col overflow-hidden rounded-[2rem] p-8 sm:p-10 lg:p-12',
							p.featured ? 'bg-wine text-cream lg:-my-6 lg:py-16' : 'border border-wine/15 bg-cream text-wine',
						]}
					>
						{p.featured && (
							<>
								<Image src={sunCream} alt="" width={300} class="pointer-events-none absolute -top-16 -right-16 w-52 opacity-10" data-spin />
								<span class="eyebrow absolute top-8 right-8 rounded-full bg-cream px-4 py-2 text-[0.6rem] text-wine sm:top-10 sm:right-10">Los más populares</span>
							</>
						)}
						<p class="eyebrow mb-10">{p.name}</p>
						<p class="display mb-2 flex items-start text-8xl font-light">
							<span class="mt-3 mr-1 text-3xl">$</span>
							{p.price}
						</p>
						<p class="mb-1 text-sm font-medium">{p.unit}</p>
						<p class="mb-10 text-xs opacity-60">{p.note}</p>
						<ul class:list={['mb-12 space-y-4 border-t pt-8 text-[0.92rem]', p.featured ? 'border-cream/20' : 'border-wine/15']}>
							{p.features.map((f) => (
								<li class="flex items-center gap-3">
									<span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', p.featured ? 'bg-cream' : 'bg-wine']} />
									{f}
								</li>
							))}
						</ul>
						<a href="#contact" data-magnetic class:list={['btn mt-auto justify-center', p.featured ? 'btn-cream' : 'btn-ghost-wine']}>
							<span>{p.cta}</span>
						</a>
					</article>
				))
			}
		</div>
		<p data-reveal class="mt-14 text-center text-sm text-wine/60">Sesiones privadas a partir de 110 $ · Disponibles tarjetas corporativas y de regalo</p>
	</div>
</section>
