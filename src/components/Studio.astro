---
import { Image } from 'astro:assets';
import facade from '../assets/img/photo-facade.jpg';
import reception from '../assets/img/photo-reception.jpg';
import reformers from '../assets/img/photo-reformers.jpg';

const scenes = [
	{
		img: facade,
		alt: 'The Veta storefront with the pose illustration in the window',
		eyebrow: 'Arrive',
		title: 'A quiet door on a busy street.',
		copy: 'Step off the sidewalk and into warmth. Dappled light, soft linen tones and a calm that settles you the moment you walk in.',
	},
	{
		img: reception,
		alt: 'Reception with the backlit Veta logo and a wooden front desk',
		eyebrow: 'Settle',
		title: 'Welcomed by name, every time.',
		copy: 'Lockers, showers, fresh towels and filtered water — everything considered, so all you need to bring is yourself.',
	},
	{
		img: reformers,
		alt: 'Veta-branded wooden reformer and chair in a sunlit studio room',
		eyebrow: 'Move',
		title: 'Crafted equipment, natural light.',
		copy: 'Twelve hand-finished wooden reformers, towers and chairs in a sun-drenched room designed for focus and flow.',
	},
];
---

<section id="studio" data-nav-theme="cream" class="relative bg-cream">
	<div class="mx-auto max-w-[1600px] px-5 pt-28 sm:px-10 sm:pt-40">
		<p data-reveal class="eyebrow mb-6 flex items-center gap-4"><span class="h-px w-10 bg-current"></span> The studio</p>
		<h2 data-split class="display max-w-4xl text-[clamp(3rem,7vw,6.5rem)] font-light">
			Designed to <em class="italic">slow you down.</em>
		</h2>
	</div>

	<!-- Desktop: pinned crossfade gallery -->
	<div data-studio class="hidden h-svh lg:block">
		<div class="mx-auto grid h-full max-w-[1600px] grid-cols-12 items-center gap-6 px-10">
			<div class="relative col-span-4 h-72">
				{
					scenes.map((s, i) => (
						<div data-studio-caption class="absolute inset-0" style={i > 0 ? 'opacity:0; visibility:hidden' : undefined}>
							<p class="eyebrow mb-6 flex items-center gap-4">
								<span class="display text-2xl tracking-normal normal-case italic">0{i + 1}</span>
								{s.eyebrow}
							</p>
							<h3 class="display mb-6 text-5xl leading-[1.02] font-light">{s.title}</h3>
							<p class="max-w-sm text-[0.95rem] leading-relaxed text-wine/75">{s.copy}</p>
						</div>
					))
				}
			</div>
			<div class="relative col-span-7 col-start-6 h-[78vh] overflow-hidden rounded-[2rem]">
				{
					scenes.map((s, i) => (
						<div data-studio-frame class="absolute inset-0 overflow-hidden" style={i > 0 ? 'clip-path: inset(100% 0 0 0)' : undefined}>
							<Image src={s.img} alt={s.alt} widths={[900, 1400, 1800]} sizes="60vw" class="h-full w-full object-cover" data-studio-img />
						</div>
					))
				}
				<div class="absolute right-6 bottom-6 flex gap-2">
					{scenes.map(() => (
						<span class="h-1 w-10 overflow-hidden rounded-full bg-cream/40">
							<span data-studio-dot class="block h-full w-full origin-left scale-x-0 bg-cream" />
						</span>
					))}
				</div>
			</div>
		</div>
	</div>

	<!-- Mobile/tablet: stacked -->
	<div class="mx-auto flex max-w-[1600px] flex-col gap-16 px-5 pt-16 pb-28 sm:px-10 lg:hidden">
		{
			scenes.map((s, i) => (
				<div data-reveal>
					<div class="mb-6 aspect-[4/5] overflow-hidden rounded-[1.5rem] sm:aspect-[16/11]">
						<Image src={s.img} alt={s.alt} widths={[600, 900, 1200]} sizes="100vw" class="h-full w-full object-cover" />
					</div>
					<p class="eyebrow mb-4">0{i + 1} — {s.eyebrow}</p>
					<h3 class="display mb-4 text-4xl font-light">{s.title}</h3>
					<p class="text-[0.95rem] leading-relaxed text-wine/75">{s.copy}</p>
				</div>
			))
		}
	</div>
</section>
